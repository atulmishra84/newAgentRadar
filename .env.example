NODE_ENV=development
PORT=4000
APP_URL=http://localhost:5173

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=agentradar
POSTGRES_USER=agentradar
POSTGRES_PASSWORD=agentradar

REDIS_HOST=localhost
REDIS_PORT=6380

JWT_SECRET=dev-only-change-me-agentradar-jwt
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
COOKIE_SECURE=false
DISCOVERY_DEMO_MODE=true
# When true, platform_admin and ciso must have MFA enrolled before login
MFA_ENFORCE=false
# Optional continuous discovery interval (ms). Min 60000. 0 = disabled.
DISCOVERY_INTERVAL_MS=0
# Docker only: run demo seed on container start (dev/demo). Leave false in production.
SEED_ON_START=false

# Optional Azure discovery
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_SUBSCRIPTION_ID=

# Optional Entra SSO
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:4000/api/auth/entra/callback

# Optional SIEM forward
SIEM_WEBHOOK_URL=

# Optional SAML IdP (or set tenants.sso_config.saml.ssoUrl)
SAML_IDP_SSO_URL=
SAML_ACS_URL=http://localhost:4000/api/auth/saml/acs
SAML_ENTITY_ID=
